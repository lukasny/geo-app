{%- comment -%}
  GEO Rise - JSON-LD Schema Injector
  Injects structured data for AI search engines and Google rich results.
  Target: head (app embed block - no visible output)
{%- endcomment -%}

{%- liquid
  assign page_type = 'other'
  if template contains 'product'
    assign page_type = 'product'
  elsif template contains 'collection'
    assign page_type = 'collection'
  elsif template contains 'article'
    assign page_type = 'article'
  elsif template contains 'blog'
    assign page_type = 'blog'
  elsif template contains 'index'
    assign page_type = 'home'
  endif
-%}

{%- comment -%} ── Organization (all pages) ── {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}
  {%- if shop.email != blank -%}
  ,"contactPoint": {
    "@type": "ContactPoint",
    "email": {{ shop.email | json }},
    "contactType": "customer service"
  }
  {%- endif -%}
}
</script>

{%- comment -%} ── WebSite with SearchAction (home page only) ── {%- endcomment -%}
{%- if page_type == 'home' -%}
{%- assign search_placeholder = '{' | append: 'search_term_string}' -%}
{%- assign search_url_template = shop.url | append: '/search?q=' | append: search_placeholder -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": {{ search_url_template | json }}
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}

{%- comment -%} ── Product Page ── {%- endcomment -%}
{%- if page_type == 'product' -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_price   = current_variant.price | divided_by: 100.0
  assign availability    = 'https://schema.org/OutOfStock'
  if product.available
    assign availability = 'https://schema.org/InStock'
  endif

  assign has_reviews      = false
  assign review_rating    = product.metafields.reviews.rating.value
  assign review_count_val = product.metafields.reviews.rating_count.value
  if review_rating != blank and review_count_val != blank
    assign has_reviews = true
  endif

  assign gtin_value = product.metafields.inventory.ean.value
  if gtin_value == blank
    assign gtin_value = product.metafields.inventory.barcode.value
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ canonical_url | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }}
  {%- if product.vendor != blank -%}
  ,"brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  }
  {%- endif -%}
  {%- if current_variant.sku != blank -%}
  ,"sku": {{ current_variant.sku | json }}
  {%- endif -%}
  {%- if gtin_value != blank -%}
  ,"gtin": {{ gtin_value | json }}
  {%- endif -%}
  {%- if product.images.size > 0 -%}
  ,"image": [
    {%- for image in product.images limit: 5 -%}
      {{ image.src | json }}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- endif -%}
  ,"offers": {
    "@type": "Offer",
    "price": {{ product_price }},
    "priceCurrency": {{ shop.currency | json }},
    "availability": {{ availability | json }},
    "url": {{ canonical_url | json }},
    "priceValidUntil": "{{ 'now' | date: '%Y' | plus: 1 }}-12-31",
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
  {%- if has_reviews -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ review_rating }},
    "reviewCount": {{ review_count_val }},
    "bestRating": "5",
    "worstRating": "1"
  }
  {%- endif -%}
}
</script>

{%- comment -%} Breadcrumb for product {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    }
    {%- if collection != blank -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ shop.url | append: collection.url | json }}
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- endif -%}
  ]
}
</script>

{%- comment -%} FAQ for product {%- endcomment -%}
{%- assign faq_value = product.metafields.geo_rise.faq.value -%}
{%- if faq_value.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq_value -%}
    {
      "@type": "Question",
      "name": {{ item.question | strip_html | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.answer | strip_html | json }}
      }
    }
    {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- endif -%}

{%- comment -%} ── Collection Page ── {%- endcomment -%}
{%- if page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "url": {{ canonical_url | json }}
  {%- if collection.description != blank -%}
  ,"description": {{ collection.description | strip_html | truncate: 300 | json }}
  {%- endif -%}
  ,"numberOfItems": {{ collection.products_count }}
  ,"mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products | size | at_most: 10 }},
    "itemListElement": [
      {%- for product in collection.products limit: 10 -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": {{ shop.url | append: product.url | json }},
        "name": {{ product.title | json }}
      }
      {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>
{%- endif -%}

{%- comment -%} ── Article Page ── {%- endcomment -%}
{%- if page_type == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  "dateModified": {{ article.updated_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  "url": {{ canonical_url | json }}
  {%- if article.image != blank -%}
  ,"image": {{ article.image.src | json }}
  {%- endif -%}
  {%- if article.content != blank -%}
  ,"articleBody": {{ article.content | strip_html | truncate: 1000 | json }}
  {%- endif -%}
  {%- if article.author != blank -%}
  ,"author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  }
  {%- endif -%}
  ,"publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }}
    {%- if settings.logo != blank -%}
    ,"logo": {
      "@type": "ImageObject",
      "url": {{ settings.logo | image_url: width: 600 | json }}
    }
    {%- endif -%}
  }
}
</script>

{%- comment -%} Breadcrumb for article {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": {{ shop.url | append: blog.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ article.title | json }},
      "item": {{ canonical_url | json }}
    }
  ]
}
</script>
{%- endif -%}

{%- comment -%} ── Blog Index Page ── {%- endcomment -%}
{%- if page_type == 'blog' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": {{ blog.title | json }},
  "url": {{ canonical_url | json }},
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }}
  }
}
</script>
{%- endif -%}

{%- comment -%}
  GEO Rise - AI Referral Tracker
  Detects when shoppers arrive from AI search engines (ChatGPT, Perplexity,
  Claude, Gemini, Grok) and tags their cart with the referring platform.
  The tag flows through to the order's note_attributes, which the
  orders/paid webhook reads to compute attributed revenue.

  Cookie + cart-attribute prefix: __geo_rise_ai_ref
  Attribution window: 30 days (cookie max-age)
  Model: last-AI-touch (most recent AI referrer overwrites the cookie)
  PII: none stored. Just the platform name and a unix timestamp.

  Visit beacon: one POST per browser session to the app proxy at
  /a/llms-txt/visit?platform={PLATFORM} so the app can count AI-referred
  visits before any order happens. sessionStorage guards against repeat
  page views re-pinging. Payload is the platform name only, nothing else.
{%- endcomment -%}
<script type="text/javascript">
(function () {
  var COOKIE_NAME = "__geo_rise_ai_ref";
  var COOKIE_MAX_AGE_SECONDS = 60 * 60 * 24 * 30; // 30 days
  var AI_DOMAINS = [
    { pattern: /(?:^|\.)chatgpt\.com$/i, platform: "CHATGPT" },
    { pattern: /(?:^|\.)chat\.openai\.com$/i, platform: "CHATGPT" },
    { pattern: /(?:^|\.)openai\.com$/i, platform: "CHATGPT" },
    { pattern: /(?:^|\.)perplexity\.ai$/i, platform: "PERPLEXITY" },
    { pattern: /(?:^|\.)claude\.ai$/i, platform: "CLAUDE" },
    { pattern: /(?:^|\.)gemini\.google\.com$/i, platform: "GEMINI" },
    { pattern: /(?:^|\.)bard\.google\.com$/i, platform: "GEMINI" },
    { pattern: /(?:^|\.)grok\.com$/i, platform: "GROK" },
    { pattern: /(?:^|\.)x\.ai$/i, platform: "GROK" }
  ];
  var UTM_MAP = {
    "chatgpt": "CHATGPT",
    "perplexity": "PERPLEXITY",
    "claude": "CLAUDE",
    "gemini": "GEMINI",
    "grok": "GROK"
  };

  function readCookie(name) {
    var match = document.cookie.match(new RegExp("(?:^|; )" + name.replace(/[.$?*|{}()[\]\\\/+^]/g, "\\$&") + "=([^;]*)"));
    return match ? decodeURIComponent(match[1]) : null;
  }

  function writeCookie(name, value) {
    document.cookie =
      name + "=" + encodeURIComponent(value) +
      "; Max-Age=" + COOKIE_MAX_AGE_SECONDS +
      "; Path=/; SameSite=Lax";
  }

  function platformFromReferrer() {
    if (!document.referrer) return null;
    try {
      var host = new URL(document.referrer).hostname;
      for (var i = 0; i < AI_DOMAINS.length; i++) {
        if (AI_DOMAINS[i].pattern.test(host)) return AI_DOMAINS[i].platform;
      }
    } catch (e) {
      return null;
    }
    return null;
  }

  function platformFromUtm() {
    try {
      var params = new URLSearchParams(window.location.search);
      var src = (params.get("utm_source") || "").toLowerCase().trim();
      if (UTM_MAP[src]) return UTM_MAP[src];
    } catch (e) {
      return null;
    }
    return null;
  }

  function platformFromCookie() {
    var raw = readCookie(COOKIE_NAME);
    if (!raw) return null;
    var parts = raw.split(":");
    return parts[0] || null;
  }

  function sendVisitBeacon(detectedPlatform) {
    // One beacon per browser session. If sessionStorage is unavailable
    // (private mode, storage blocked) skip entirely: undercounting one
    // visit is better than pinging on every page view.
    var GUARD_KEY = "__geo_rise_ai_visit_sent";
    try {
      if (sessionStorage.getItem(GUARD_KEY)) return;
      sessionStorage.setItem(GUARD_KEY, "1");
    } catch (e) {
      return;
    }
    var url = "/a/llms-txt/visit?platform=" + encodeURIComponent(detectedPlatform);
    var queued = false;
    if (navigator.sendBeacon) {
      try {
        queued = navigator.sendBeacon(url);
      } catch (e) {
        queued = false;
      }
    }
    if (!queued) {
      fetch(url, { method: "POST", keepalive: true }).catch(function () {
        // Silent: tracking failure must never break the storefront page.
      });
    }
  }

  function runTracking(freshPlatform, platform) {
    writeCookie(COOKIE_NAME, platform + ":" + Math.floor(Date.now() / 1000));

    fetch("/cart/update.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        attributes: { "__geo_rise_ai_ref": platform }
      }),
      credentials: "same-origin"
    }).catch(function () {
      // Silent: tracking failure must never break the storefront page.
    });

    // Beacon only on fresh detection. The cookie fallback exists for
    // last-AI-touch cart attribution; letting it fire the beacon would count
    // every direct return session within the 30-day cookie as a new AI
    // visit, contradicting the revenue page's "counted once per browser
    // session when a shopper lands from an AI platform" copy.
    if (freshPlatform) {
      sendVisitBeacon(freshPlatform);
    }
  }

  var freshPlatform = platformFromReferrer() || platformFromUtm();
  var platform = freshPlatform || platformFromCookie();
  if (!platform) return;

  // Consent gate. This tracker sets a non-essential analytics cookie, so in
  // consent-required regions (EU/EEA) it must wait for consent. Shopify's
  // Customer Privacy API is the source of truth, but it loads ASYNCHRONOUSLY
  // (window.Shopify.customerPrivacy is not guaranteed to exist when this head
  // script runs), so we must NOT treat "not loaded yet" as "no consent
  // regime". We load the API explicitly via Shopify.loadFeatures and gate
  // inside the callback; only when the API genuinely cannot be loaded (no
  // consent framework on the store) do we fail open and track as before.
  // Every path is guarded by `tracked` so nothing double-fires.
  var tracked = false;

  function runIfAllowed() {
    if (tracked) return;
    var cp = window.Shopify && window.Shopify.customerPrivacy;
    if (!cp || typeof cp.analyticsProcessingAllowed !== "function") return;
    var ok = false;
    try {
      ok = cp.analyticsProcessingAllowed() === true;
    } catch (e) {
      ok = false;
    }
    if (ok) {
      tracked = true;
      runTracking(freshPlatform, platform);
    }
  }

  function failOpen() {
    if (tracked) return;
    tracked = true;
    runTracking(freshPlatform, platform);
  }

  // A later consent change (decline then accept) re-checks and tracks once.
  document.addEventListener("visitorConsentCollected", runIfAllowed);

  if (window.Shopify && typeof window.Shopify.loadFeatures === "function") {
    window.Shopify.loadFeatures(
      [{ name: "consent-tracking-api", version: "0.1" }],
      function (error) {
        var cp = window.Shopify && window.Shopify.customerPrivacy;
        if (error || !cp || typeof cp.analyticsProcessingAllowed !== "function") {
          // No consent framework available on this store: fail open.
          failOpen();
          return;
        }
        // API is ready: track now if allowed, else wait for the consent event.
        runIfAllowed();
      }
    );
  } else {
    // No Shopify.loadFeatures at all: no consent framework, fail open.
    failOpen();
  }
})();
</script>

{% schema %}
{
  "name": "GEO Rise Schema",
  "target": "head",
  "settings": []
}
{% endschema %}
