generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  GROWTH
  PRO
  ENTERPRISE
}

enum AuditCategory {
  SCHEMA
  CONTENT
  TECHNICAL
  ACCESSIBILITY
  IMAGES
  META
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AiPlatform {
  CHATGPT
  GEMINI
  PERPLEXITY
  CLAUDE
  GROK
  GOOGLE_AI_OVERVIEW
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum TrackingSchedule {
  MANUAL
  DAILY
  WEEKLY
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELLED
  EXPIRED
  FROZEN // Shopify paused billing (shop paused / payment failure); temporary
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id                      String    @id @default(cuid())
  shopifyDomain           String    @unique
  shopifyAccessToken      String
  shopName                String
  email                   String?
  plan                    Plan      @default(FREE)
  // Phase D3 - insight emails. Default ON for newly-installed Growth+ stores;
  // FREE stores stay opted out at the plan-tier gate even when this is true.
  weeklyInsightEnabled    Boolean   @default(true)
  lastInsightSentAt       DateTime?
  geoScore                Int       @default(0)
  // F4 AI shopping readiness: rounded mean of the latest audit run's
  // per-product readiness scores (catalog attribute completeness for AI
  // shopping agents). Null until the first post-F4 audit; the UI renders
  // a dash for null, never 0/100.
  readinessScore          Int?
  totalProducts           Int       @default(0)
  auditedProducts         Int       @default(0)
  llmsTxtEnabled          Boolean   @default(false)
  schemaInjectionEnabled  Boolean   @default(false)
  onboardingCompleted     Boolean   @default(false)
  // Phase F6 - FAQ generator. The product FAQ metafield definition (namespace
  // geo_rise, key faq) is created lazily on the store's first publish. Once
  // created we flip this true so later publishes skip the definitionCreate.
  faqMetafieldDefinitionCreated Boolean @default(false)
  installedAt             DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  products         Product[]
  auditResults     AuditResult[]
  llmsFiles        LlmsFile[]
  aiCitations      AiCitation[]
  trackingPrompts  TrackingPrompt[]
  competitors      Competitor[]
  aiTrafficEvents  AiTrafficEvent[]
  simulationUsages SimulationUsage[]
  blogPosts        BlogPost[]
  aiCrawlerHits    AiCrawlerHit[]
  scoreSnapshots   ScoreSnapshot[]
  sourcePresences  SourcePresence[]
  productFaqs      ProductFaq[]
  subscription     Subscription?
}

model Product {
  id                  String    @id @default(cuid())
  storeId             String
  shopifyProductId    String
  shopifyVariantIds   Json?
  title               String
  description         String?   @db.Text
  handle              String
  productType         String?
  vendor              String?
  status              String    @default("active")
  price               String?
  currency            String?
  imageCount          Int       @default(0)
  hasAltText          Boolean   @default(false)
  altTextQuality      Int       @default(0)
  hasMetaTitle        Boolean   @default(false)
  hasMetaDescription  Boolean   @default(false)
  hasSchema           Boolean   @default(false)
  hasRichDescription  Boolean   @default(false)
  descriptionWordCount Int      @default(0)
  hasReviews          Boolean   @default(false)
  reviewCount         Int       @default(0)
  averageRating       Float?
  variantCount        Int       @default(0)
  variantsComplete    Boolean   @default(false)
  hasTags             Boolean   @default(false)
  aiReadinessScore    Int       @default(0)
  // F4 AI shopping readiness, PARALLEL to the GEO-facing score above. Null
  // means "not computed yet": products audited before F4 keep null until
  // their next audit and the UI renders a dash, never 0/100. readinessGaps
  // is a JSON array of ReadinessGapKey strings (readiness.shared.ts).
  readinessScore      Int?
  readinessGaps       Json?
  lastAuditedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  auditResults AuditResult[]

  @@unique([storeId, shopifyProductId])
  @@index([storeId])
}

model AuditResult {
  id             String        @id @default(cuid())
  storeId        String
  productId      String?
  category       AuditCategory
  severity       Severity
  title          String
  description    String        @db.Text
  recommendation String        @db.Text
  autoFixable    Boolean       @default(false)
  fixed          Boolean       @default(false)
  fixedAt        DateTime?
  createdAt      DateTime      @default(now())

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
}

model LlmsFile {
  id                 String    @id @default(cuid())
  storeId            String
  content            String    @db.Text
  marketCode         String    @default("default")
  productCount       Int       @default(0)
  collectionCount    Int       @default(0)
  blogPostCount      Int       @default(0)
  includeProducts    Boolean   @default(true)
  includeCollections Boolean   @default(true)
  includeBlogPosts   Boolean   @default(true)
  allowChatGPT       Boolean   @default(true)
  allowClaude        Boolean   @default(true)
  allowGemini        Boolean   @default(true)
  allowPerplexity    Boolean   @default(true)
  allowDeepSeek      Boolean   @default(true)
  allowGrok          Boolean   @default(true)
  autoRefresh        Boolean   @default(true)
  refreshInterval    String    @default("daily")
  fileSizeBytes      Int       @default(0)
  lastGeneratedAt    DateTime?
  // True once the storefront /llms.txt -> /a/llms-txt redirect has been
  // created (or confirmed to already exist). Default-market generation
  // attempts the redirect whenever this is false, so existing stores and
  // stores that failed before re-auth get it on a later generation, and it
  // is attempted at most once per store after it succeeds.
  rootRedirectCreated Boolean  @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, marketCode])
}

model AiCitation {
  id               String     @id @default(cuid())
  storeId          String
  platform         AiPlatform
  prompt           String     @db.Text
  promptCategory   String?
  cited            Boolean    @default(false)
  position         Int?
  citationContext  String?    @db.Text
  sentiment        Sentiment  @default(NEUTRAL)
  competitorsCited Json?
  productsCited    Json?
  // string[] of full source URLs the platform consulted or cited (max 20,
  // each capped at 500 chars). Null on rows written before the source radar.
  sourcesCited     Json?
  responseSnippet  String?    @db.Text
  checkedAt        DateTime   @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, platform])
  @@index([storeId, checkedAt])
  @@index([checkedAt])
}

model TrackingPrompt {
  id              String           @id @default(cuid())
  storeId         String
  prompt          String           @db.Text
  category        String?
  targetKeywords  Json?
  isActive        Boolean          @default(true)
  lastCheckedAt   DateTime?
  createdAt       DateTime         @default(now())
  schedule        TrackingSchedule @default(MANUAL)
  nextRunAt       DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([nextRunAt])
}

model Competitor {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  domain    String
  notes     String?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Prevent the same merchant from tracking the same domain twice. Domain
  // is stored already-normalized (hostname, lowercase, no protocol/path/www
  // prefix) so dupes can be enforced at the DB layer.
  @@unique([storeId, domain])
  @@index([storeId])
}

model AiTrafficEvent {
  id               String     @id @default(cuid())
  storeId          String
  platform         AiPlatform
  referrerUrl      String?
  landingPage      String
  sessionId        String?
  convertedToOrder Boolean    @default(false)
  orderId          String?
  orderRevenue     Float?
  orderCurrency    String?
  eventAt          DateTime   @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Shopify webhook delivery is at-least-once; this makes the orders/paid
  // insert idempotent so redeliveries can't double-count revenue. orderId is
  // nullable and Postgres treats NULLs as distinct, so referral events
  // without an order are unaffected.
  @@unique([storeId, orderId])
  @@index([storeId])
  @@index([storeId, eventAt])
  @@index([storeId, platform])
}

model Subscription {
  id                     String             @id @default(cuid())
  storeId                String             @unique
  shopifySubscriptionId  String?
  plan                   Plan               @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// One row per successful AI Simulator run. Used to enforce plan limits on
// monthly simulator usage (FREE: 3/mo, GROWTH+: unlimited).
model SimulationUsage {
  id        String   @id @default(cuid())
  storeId   String
  productId String?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, createdAt])
}

// One row per llms.txt proxy request, written fire-and-forget by the public
// proxy route. ALL hits are logged, not just AI bots - botName stays null
// for browsers and unknown UAs so the manager page can report "9 of 14
// fetches were AI bots". userAgent is capped at 250 chars before insert so
// a hostile client can't bloat rows with megabyte headers.
// One counter row per (store, bot, UTC day). The public llms.txt proxy is
// unauthenticated, so a row-per-request design let any client grow this
// table without bound; collapsing to a daily counter caps it at
// stores x bots x retained-days and makes the stats queries trivial.
model AiCrawlerHit {
  id      String @id @default(cuid())
  storeId String
  // Canonical bot id from classifyCrawler ("GPTBot", "ClaudeBot", ...), or
  // "" for unclassified traffic (browsers / unknown UAs). Empty string,
  // never null: the [storeId, botName, day] unique key dedupes the upsert,
  // and Postgres treats NULLs as distinct, which would defeat it.
  botName String @default("")
  // UTC calendar day this row counts hits for (stored at 00:00:00Z).
  day           DateTime
  count         Int      @default(0)
  // Most recent raw User-Agent seen for this bot/day, for display only.
  lastUserAgent String   @default("")
  lastHitAt     DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, botName, day])
  @@index([storeId, day])
}

// One row per successful full audit, written fire-and-forget by
// audit-engine right after the store score persists. Powers the dashboard
// score sparkline and the weekly email delta. The wizard's 5-product
// starter audit (and any audit capped at 5 products or fewer, including
// the FREE plan's 3-product cap) never writes a row, so the trend only
// compares like-for-like full audits.
model ScoreSnapshot {
  id              String   @id @default(cuid())
  storeId         String
  score           Int
  auditedProducts Int
  issueCount      Int
  createdAt       DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

// One row per generated blog post. Stored locally as a draft until the
// merchant clicks "Publish" - then we POST to Shopify's articleCreate
// mutation and stamp shopifyArticleId + publishedAt. Counting rows from
// the start of the current calendar month enforces the monthly plan cap
// (Free: 0, Growth: 5, Pro: 20, Enterprise: 100).
model BlogPost {
  id               String    @id @default(cuid())
  storeId          String
  // Inputs the merchant provided so we can re-generate or audit later.
  topic            String    @db.Text
  targetKeywords   Json?
  tone             String?
  // Claude's structured output, sanitized.
  title            String
  excerpt          String    @db.Text
  bodyHtml         String    @db.Text
  tags             Json?
  metaTitle        String?
  metaDescription  String?   @db.Text
  wordCount        Int       @default(0)
  // "draft" (in our DB only) or "published" (created on Shopify). Soft-delete
  // via "deleted" so we can keep monthly-usage counts honest after a delete.
  status           String    @default("draft")
  shopifyArticleId String?
  shopifyBlogId    String?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

// Phase F6 - FAQ generator. One row per generation run for one product:
// Claude drafts answer-first Q/A pairs, the merchant reviews on screen, then
// "Publish" writes them to the product's geo_rise.faq metafield (JSON) and the
// theme extension renders them as FAQPage JSON-LD. Regenerating a product is a
// new row (a new AI call) so it counts again toward the monthly cap. Soft-delete
// via status "deleted" keeps monthly-usage counts honest after a delete.
model ProductFaq {
  id               String    @id @default(cuid())
  storeId          String
  // Stored in the same format the Product model uses (bare numeric id). We
  // convert to gid://shopify/Product/<id> at metafield write time.
  shopifyProductId String
  // Denormalized so the "your FAQs" list renders without a Product join.
  productTitle     String
  // Array of { question: string; answer: string }, Claude's validated output.
  questions        Json
  // "generating" (in-flight placeholder) | "draft" | "published" (metafield
  // written) | "failed" | "deleted" (soft-delete).
  status           String    @default("draft")
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([storeId, shopifyProductId])
}

// One row per (store, source URL) presence check, upserted by the on-demand
// "check my presence" action on the tracking page. `present` records whether
// the store's name or own domain appeared in the fetched page body. A non-2xx
// response or fetch error never writes a row, so a missing/stale row honestly
// means "not checked" rather than a fabricated miss.
model SourcePresence {
  id        String   @id @default(cuid())
  storeId   String
  url       String   @db.VarChar(500)
  present   Boolean
  checkedAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, url])
  @@index([storeId, checkedAt])
}
